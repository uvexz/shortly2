# Turso / libSQL. Local development can use a file URL without a token.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
# Optional legacy fallback used by some tooling.
DATABASE_URL=file:local.db
# Enable schema bootstrap when running a production build against a fresh DB.
DATABASE_AUTO_INIT=
DATABASE_LEGACY_REBUILD=
DATABASE_REQUEST_TIMEOUT_MS=15000
DATABASE_QUERY_LOG=false

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars
API_KEY_PEPPER=
BOOTSTRAP_ADMIN_EMAILS=
TRUST_X_FORWARDED_FOR=true
TRUST_PROXY_HOPS=1

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend email OTP (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=shortly@example.com
# Development-only: enable email OTP and print codes to the dev server log.
AUTH_OTP_DEV_LOG=false

# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inbound temp email
INBOUND_EMAIL_SECRET=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
